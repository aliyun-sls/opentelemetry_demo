{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "title": "Values",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "description": "Usually used when using Opentelemetry-demo as a subchart.",
      "type": "boolean"
    },
    "global": {
      "type": "object"
    },
    "default": {
      "$ref": "#/definitions/Default"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["create"]
    },
    "components": {
      "$ref": "#/definitions/Components"
    },
    "chaosblade-operator": {
      "type": "object"
    },
    "opentelemetry-collector": {
      "type": "object"
    },
    "prometheus": {
      "type": "object"
    },
    "jaeger": {
      "type": "object"
    },
    "opensearch": {
      "type": "object"
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Enable or disable the secret creation.",
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["data"]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "imagePullSecrets": {
          "type": "string"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "rebalance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pod distribution rebalancing CronJob configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable the rebalance CronJob"
        },
        "schedule": {
          "type": "string",
          "pattern": "^[0-9*,/-]+\\s+[0-9*,/-]+\\s+[0-9*,/-]+\\s+[0-9*,/-]+\\s+[0-9*,/-]+$",
          "description": "Cron schedule expression"
        },
        "strategy": {
          "type": "string",
          "enum": ["balanced", "conservative", "aggressive"],
          "description": "Rebalance strategy: balanced (1/3), conservative (1/4), aggressive (1/2)"
        },
        "imbalanceThreshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Imbalance threshold (coefficient of variation)"
        },
        "minPodsPerComponent": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of pods per component to trigger rebalancing"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "description": "Container image repository"
            },
            "tag": {
              "type": "string",
              "description": "Container image tag"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"],
              "description": "Image pull policy"
            }
          },
          "required": ["repository", "tag"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": ["name"]
          },
          "description": "Image pull secrets"
        },
        "waitTime": {
          "type": "integer",
          "minimum": 0,
          "description": "Wait time after pod deletion (seconds)"
        },
        "componentWaitTime": {
          "type": "integer",
          "minimum": 0,
          "description": "Wait time between component processing (seconds)"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Node selector for CronJob pod placement"
        },
        "affinity": {
          "type": "object",
          "description": "Affinity rules for CronJob pod placement"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Tolerations for CronJob pod placement"
        },
        "securityContext": {
          "type": "object",
          "description": "Security context for the CronJob pod"
        },
        "containerSecurityContext": {
          "type": "object",
          "description": "Security context for the container"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "description": "Resource limits and requests"
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of successful job history to keep"
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of failed job history to keep"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of retries before marking job as failed"
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0,
          "description": "TTL for job cleanup after completion (seconds)"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations for the CronJob"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations for the job pods"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Environment variables for the container"
        }
      }
    }
  },
  "required": [
    "components",
    "serviceAccount"
  ],
