    "LivenessProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "httpGet"
      ],
      "properties": {
        "httpGet": {
          "type": "object",
          "required": [
            "port"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "scheme": {
              "type": "string"
            },
            "httpHeaders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "initialDelaySeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "successThreshold": {
          "type": "integer"
        },
        "failureThreshold": {
